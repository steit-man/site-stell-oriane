# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS le fichier .env.
PORT=3000

# --- Compte administrateur (créé / mis à jour automatiquement au démarrage) ---
# Pour changer le mot de passe admin : modifiez ADMIN_PASSWORD puis redémarrez le serveur.
ADMIN_PHONE=12341
ADMIN_PASSWORD=0001
# ⚠️ "0001" est facile à deviner : avant de mettre le site en ligne, choisissez un mot de passe long (12+ caractères).

# --- Clé secrète des sessions (optionnel : générée automatiquement dans data/jwt.secret si vide) ---
JWT_SECRET=

# --- Assistant IA (questions techniques) : clé API Anthropic, uniquement côté serveur ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Emails d'assistance (questions d'argent) ---
SUPPORT_EMAIL=lsteit772@gmail.com
# Exemple Gmail : activez la validation en 2 étapes puis créez un "mot de passe d'application"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lsteit772@gmail.com
SMTP_PASS=
SMTP_FROM=

# --- Hébergement derrière un proxy HTTPS (Nginx, Render, Railway...) : mettre 1 ---
TRUST_PROXY=
